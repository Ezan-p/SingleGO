{
  "envId": "{{env.ENV_ID}}",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "getOpenId",
      "timeout": 5,
      "envVariables": {},
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "quickstartFunctions",
      "timeout": 5,
      "envVariables": {},
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "matchSystem",
      "timeout": 5,
      "envVariables": {},
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "matchChecker",
      "timeout": 10,
      "envVariables": {},
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "gameSync",
      "timeout": 5,
      "envVariables": {},
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codex": {
        "type": "cloudbase",
        "provider": "deepseek",
        "model": "deepseek-v3"
      },
      "codebuddy": {
        "type": "none"
      }
    }
  }
}