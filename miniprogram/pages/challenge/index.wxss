.container {
  min-height: 100vh;
  padding: 40rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 沿用首页木金深色基调 */
  background:
    radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
  color: #F0E4D0;
}

/* 顶栏 */
.top-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #E8B870;
  padding: 8rpx 4rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #E8B870;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.top-placeholder {
  width: 80rpx;
}

/* 统计条 */
.stat-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #E8B870;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background-color: rgba(232, 184, 112, 0.2);
}

.hint {
  font-size: 24rpx;
  color: rgba(240, 228, 208, 0.65);
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

/* 管理操作 */
.manage-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.manage-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 38rpx;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.35);
  color: #E8B870;
}

.manage-btn-danger {
  border-color: rgba(229, 57, 53, 0.6);
  color: #EF9A9A;
}

/* 关卡网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-cell {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  font-weight: bold;
  margin-bottom: 18rpx;
}

.cell-num {
  font-size: 30rpx;
}

/* 未解锁 */
.level-locked {
  background: rgba(40, 28, 16, 0.5);
  border: 1px solid rgba(232, 184, 112, 0.12);
  color: rgba(232, 184, 112, 0.35);
}

.lock-icon {
  font-size: 30rpx;
  opacity: 0.6;
}

/* 已解锁未通关 */
.level-unlocked {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  color: #FFF8E8;
  border: 1px solid rgba(232, 184, 112, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

/* 已通关 */
.level-cleared {
  background: rgba(76, 175, 80, 0.18);
  border: 1px solid rgba(76, 175, 80, 0.6);
  color: #A5D6A7;
}

.check-icon {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  font-size: 24rpx;
  color: #4CAF50;
}

/* 档位（难度）配色：左缘描边，避免覆盖 state 背景 */
.tier-easy   { border-left: 6rpx solid #7FB069; }
.tier-normal { border-left: 6rpx solid #4FA3D1; }
.tier-hard   { border-left: 6rpx solid #E8943C; }
.tier-master { border-left: 6rpx solid #C95B8A; }

/* 档位分组标题 */
.tier-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  margin: 28rpx 0 14rpx;
  padding-left: 14rpx;
  border-left: 8rpx solid #E8B870;
  box-sizing: border-box;
}

.tier-header.tier-easy   { border-left-color: #7FB069; }
.tier-header.tier-normal { border-left-color: #4FA3D1; }
.tier-header.tier-hard   { border-left-color: #E8943C; }
.tier-header.tier-master { border-left-color: #C95B8A; }

.tier-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #E8B870;
}

.tier-sub {
  font-size: 22rpx;
  color: rgba(240, 228, 208, 0.6);
  margin-top: 4rpx;
}
