.setup-page {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
  background-color: var(--background);
}

.setup-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.setup-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.setup-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--light-text);
}

.section {
  margin-bottom: 50rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.diff-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.diff-card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.diff-card-active {
  border-color: var(--primary-color);
  background-color: rgba(30, 136, 229, 0.06);
}

.diff-card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.diff-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.diff-check {
  color: var(--primary-color);
  font-size: 36rpx;
  font-weight: bold;
}

.diff-desc {
  display: block;
  font-size: 26rpx;
  color: var(--light-text);
  line-height: 1.6;
}

.color-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.color-card {
  flex: 1;
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.color-card-active {
  border-color: var(--primary-color);
  background-color: rgba(30, 136, 229, 0.06);
}

.color-stone {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.color-black {
  background: radial-gradient(circle at 30% 30%, #666 0%, #000 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.color-white {
  background: radial-gradient(circle at 30% 30%, #fff 0%, #ddd 100%);
  border: 1px solid #999;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.color-label {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: 500;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  margin-top: 20rpx;
}
