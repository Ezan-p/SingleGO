.game-online-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
  background: radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
}

/* 对手信息条 */
.players-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.player-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2px solid #E8B870;
}

.player-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  flex: 1;
}

.player-info-right {
  margin-left: 0;
  margin-right: 16rpx;
  align-items: flex-end;
}

.player-name {
  font-size: 28rpx;
  color: #E8B870;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-tag {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.6);
  margin-top: 4rpx;
}

.vs-text {
  font-size: 26rpx;
  color: rgba(232, 184, 112, 0.5);
  margin: 0 12rpx;
}

.stone-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.dot-black {
  background: radial-gradient(circle at 30% 30%, #666 0%, #000 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.dot-white {
  background: radial-gradient(circle at 30% 30%, #fff 0%, #ddd 100%);
  border: 1px solid #999;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 状态栏 */
.status-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.player-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8B870;
  letter-spacing: 2rpx;
}

.undo-notice {
  color: #ff9800;
  font-size: 24rpx;
}

.move-count {
  font-size: 28rpx;
  color: rgba(232, 184, 112, 0.7);
}

/* 悔棋请求弹窗 */
.undo-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.undo-modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: center;
}

.undo-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.undo-message {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.undo-buttons {
  display: flex;
  gap: 20rpx;
}

.undo-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
}

/* 棋盘 */
.board-wrapper {
  margin: 0 auto 24rpx;
  border: 8rpx solid #7A5230;
  border-radius: 10rpx;
  box-shadow:
    0 10rpx 28rpx rgba(0, 0, 0, 0.28),
    0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 50%, #F0C478 0%, #DCA558 100%);
  position: relative;
}

.board-grid {
  display: flex;
  flex-wrap: wrap;
  background-image:
    linear-gradient(to right, #3a2f1f 1px, transparent 1px),
    linear-gradient(to bottom, #3a2f1f 1px, transparent 1px);
}

.cell {
  position: relative;
  box-sizing: border-box;
}

.star-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16%;
  height: 16%;
  border-radius: 50%;
  background-color: #3a2f1f;
  z-index: 1;
}

.stone {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  height: 90%;
  border-radius: 50%;
  z-index: 2;
}

.stone-black {
  background: radial-gradient(circle at 30% 30%, #666666 0%, #000000 100%);
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.35);
}

.stone-white {
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, #dddddd 100%);
  border: 1px solid #999999;
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.15);
}

.last-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96%;
  height: 96%;
  border-radius: 50%;
  border: 3px solid #E8B870;
  box-sizing: border-box;
  z-index: 3;
}

/* 两下落子预览：半透明棋形提示 */
.preview {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  height: 84%;
  border-radius: 50%;
  z-index: 3;
  pointer-events: none;
  animation: preview-pulse 1.1s ease-in-out infinite;
}

.preview-black {
  background: radial-gradient(circle at 30% 30%, rgba(120, 120, 120, 0.55) 0%, rgba(0, 0, 0, 0.5) 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.preview-white {
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.7) 0%, rgba(210, 210, 210, 0.6) 100%);
  border: 1px solid rgba(150, 150, 150, 0.5);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

@keyframes preview-pulse {
  0%, 100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}

/* 胜利棋形高亮 */
.win-highlight {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4px solid #FFD700;
  box-sizing: border-box;
  z-index: 4;
  animation: win-pulse 1.2s ease-in-out infinite;
}

.cell-win-target .win-highlight {
  border-color: #FF4444;
  border-width: 5px;
}

@keyframes win-pulse {
  0%, 100% {
    box-shadow: 0 0 8px rgba(255, 215, 0, 0.6);
    opacity: 0.85;
  }
  50% {
    box-shadow: 0 0 20px rgba(255, 215, 0, 1);
    opacity: 1;
  }
}

/* 网络状态徽标 */
.net-badge {
  position: fixed;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  z-index: 50;
}

.net-online {
  background: rgba(76, 175, 80, 0.85);
}

.net-offline {
  background: rgba(244, 67, 54, 0.9);
}

/* 掉线横幅 */
.disconnect-banner {
  background: rgba(244, 67, 54, 0.9);
  color: #fff;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

/* 控制按钮禁用态 */
.ctrl-btn-disabled {
  opacity: 0.4;
}

/* 结算 overlay */
.settlement-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: promoFadeIn 0.3s ease-out;
}

.settlement-card {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 84%;
  max-width: 620rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.6);
  animation: promoScaleIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.settlement-result {
  text-align: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
}

.result-win .result-title {
  color: #FFE082;
  text-shadow: 0 2px 8px rgba(255, 224, 130, 0.5);
}

.result-loss .result-title {
  color: #EF9A9A;
}

.settlement-body {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
}

.settlement-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.settlement-label {
  font-size: 26rpx;
  color: rgba(255, 248, 232, 0.7);
}

.settlement-value {
  font-size: 28rpx;
  color: #FFF8E8;
  font-weight: 600;
}

.points-up {
  color: #A5D6A7;
}

.points-down {
  color: #EF9A9A;
}

.settlement-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.settlement-btn {
  width: 100%;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 再来一局邀请 */
.rematch-invite-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2100;
}

.rematch-invite-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  width: 80%;
  max-width: 560rpx;
  text-align: center;
}

.rematch-invite-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.rematch-invite-msg {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 36rpx;
}

.rematch-invite-buttons {
  display: flex;
  gap: 20rpx;
}

.rematch-invite-buttons .btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* 按钮通用样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  text-align: center;
  transition: all 0.2s;
  cursor: pointer;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background: #4CAF50;
  color: white;
}

.btn-secondary {
  background: #757575;
  color: white;
}

.btn-ghost {
  background: transparent;
  color: rgba(255, 248, 232, 0.8);
  border: 1px solid rgba(255, 248, 232, 0.4);
}

/* 控制按钮 */
.controls {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ctrl-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  letter-spacing: 4rpx;
  transition: all 0.2s;
}

.ctrl-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-undo {
  background: #2196F3;
  color: white;
}

.btn-resign {
  background: #ff5252;
  color: white;
}

.btn-leave {
  background: transparent;
  color: #E8B870;
  border: 1px solid rgba(232, 184, 112, 0.6);
}

/* 升段动画 */
.promotion-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: promoFadeIn 0.3s ease-out;
}

.promotion-card {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border-radius: 24rpx;
  padding: 60rpx 80rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.6);
  animation: promoScaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.promotion-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.promotion-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FFF8E8;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.promotion-old {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 248, 232, 0.6);
  margin-bottom: 16rpx;
}

.promotion-arrow {
  font-size: 40rpx;
  color: rgba(255, 248, 232, 0.8);
  margin-bottom: 16rpx;
}

.promotion-new {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #FFF8E8;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.promotion-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 248, 232, 0.4);
}

@keyframes promoFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes promoScaleIn {
  from { transform: scale(0.3); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}