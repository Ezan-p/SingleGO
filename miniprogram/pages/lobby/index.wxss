.lobby-page {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 网络状态 */
.net-badge {
  position: fixed;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  z-index: 10;
}

.net-online {
  background: rgba(76, 175, 80, 0.85);
}

.net-offline {
  background: rgba(244, 67, 54, 0.9);
}

/* 玩家卡片 */
.player-card {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border: 1px solid rgba(232, 184, 112, 0.4);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-top: 60rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #E8B870;
  margin-right: 30rpx;
  background: #eee;
}

.player-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF8E8;
  margin-bottom: 12rpx;
}

.rank-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #E8B870;
  font-weight: 600;
  margin-right: 20rpx;
}

.rank-points {
  font-size: 24rpx;
  color: rgba(255, 248, 232, 0.7);
}

.uid-line {
  margin-top: 4rpx;
}

.uid-text {
  font-size: 22rpx;
  color: rgba(255, 248, 232, 0.5);
}

/* 战绩卡片 */
.stats-card {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-top: 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.3);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF8E8;
  margin-bottom: 8rpx;
}

.stats-win {
  color: #A5D6A7;
}

.stats-loss {
  color: #EF9A9A;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 248, 232, 0.6);
}

/* 操作区 */
.actions {
  margin-top: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn {
  width: 80%;
  padding: 28rpx 0;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  transition: all 0.3s;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: linear-gradient(135deg, #E8B870 0%, #C8923C 100%);
  color: #3D2410;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.btn-secondary {
  background: rgba(232, 184, 112, 0.15);
  color: #FFF8E8;
  border: 2rpx solid rgba(232, 184, 112, 0.5);
}

.btn-ghost {
  background: transparent;
  color: rgba(232, 184, 112, 0.85);
  font-size: 28rpx;
  padding: 16rpx 0;
}

.btn-disabled {
  opacity: 0.6;
}
