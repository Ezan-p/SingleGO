.game-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--background);
}

/* 状态栏 */
.status-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.player-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stone-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.dot-black {
  background: radial-gradient(circle at 30% 30%, #666 0%, #000 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.dot-white {
  background: radial-gradient(circle at 30% 30%, #fff 0%, #ddd 100%);
  border: 1px solid #999;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.move-count {
  font-size: 28rpx;
  color: var(--light-text);
}

/* AI 信息条 */
.ai-info-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: rgba(30, 136, 229, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 24rpx;
}

.info-item {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.info-sep {
  margin: 0 16rpx;
  color: var(--light-text);
}

/* 棋盘 */
.board-wrapper {
  margin: 0 auto 24rpx;
  border: 8rpx solid #7A5230;
  border-radius: 10rpx;
  box-shadow:
    0 10rpx 28rpx rgba(0, 0, 0, 0.28),
    0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 50%, #F0C478 0%, #DCA558 100%);
  position: relative;
}

.board-grid {
  display: flex;
  flex-wrap: wrap;
  background-image:
    linear-gradient(to right, #3a2f1f 1px, transparent 1px),
    linear-gradient(to bottom, #3a2f1f 1px, transparent 1px);
}

.cell {
  position: relative;
  box-sizing: border-box;
}

.star-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16%;
  height: 16%;
  border-radius: 50%;
  background-color: #3a2f1f;
  z-index: 1;
}

.stone {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  height: 90%;
  border-radius: 50%;
  z-index: 2;
}

.stone-black {
  background: radial-gradient(circle at 30% 30%, #666666 0%, #000000 100%);
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.35);
}

.stone-white {
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, #dddddd 100%);
  border: 1px solid #999999;
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.15);
}

.last-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96%;
  height: 96%;
  border-radius: 50%;
  border: 3px solid #1E88E5;
  box-sizing: border-box;
  z-index: 3;
}

/* 胜利动画：被围目标棋子红色脉冲环 */
.win-target-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 112%;
  height: 112%;
  border-radius: 50%;
  border: 4px solid #E53935;
  box-sizing: border-box;
  z-index: 6;
  animation: win-pulse 0.9s ease-in-out infinite;
}

/* 胜利动画：围子棋子绿色发光环 */
.win-stone-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 104%;
  height: 104%;
  border-radius: 50%;
  border: 3px solid #4CAF50;
  box-sizing: border-box;
  z-index: 5;
  animation: win-glow 0.9s ease-in-out infinite;
}

@keyframes win-pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.25); opacity: 0.6; }
}

@keyframes win-glow {
  0%, 100% { transform: translate(-50%, -50%) scale(1); box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
  50% { transform: translate(-50%, -50%) scale(1.12); box-shadow: 0 0 10rpx 5rpx rgba(76, 175, 80, 0.85); }
}

/* 待确认落子（首次点击）半透明棋子 + 绿色确认环 */
.pending-stone {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  height: 84%;
  border-radius: 50%;
  opacity: 0.5;
  border: 3px solid #4CAF50;
  box-sizing: border-box;
  z-index: 4;
}

.pending-black {
  background: radial-gradient(circle at 30% 30%, #666 0%, #000 100%);
}

.pending-white {
  background: radial-gradient(circle at 30% 30%, #fff 0%, #ddd 100%);
}

/* 结果横幅 */
.result-banner {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.3);
}

.result-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.result-reason {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ctrl-btn {
  flex: 1;
  margin: 0;
}

.ctrl-btn-disabled {
  opacity: 0.45;
}

/* 棋盘尺寸选择 */
.size-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.size-label {
  font-size: 28rpx;
  color: var(--light-text);
  margin-right: 20rpx;
}

.picker-value {
  color: var(--primary-color);
  font-size: 30rpx;
  font-weight: 500;
  padding: 6rpx 24rpx;
  background-color: rgba(30, 136, 229, 0.1);
  border-radius: 24rpx;
}

/* 自定义结算弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
}

.result-card {
  position: relative;
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.3);
  animation: result-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes result-pop {
  0% { transform: scale(0.7); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.result-title-wrap {
  text-align: center;
  margin-bottom: 36rpx;
}

.result-title {
  display: inline-block;
  font-size: 60rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.title-win {
  color: #4CAF50;
  text-shadow: 0 2rpx 12rpx rgba(76, 175, 80, 0.3);
}

.title-lose {
  color: #E53935;
  text-shadow: 0 2rpx 12rpx rgba(229, 57, 53, 0.25);
}

/* 获胜信息三列网格 */
.result-info-grid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background-color: #F7F9FC;
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  margin-bottom: 36rpx;
}

.info-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.info-divider {
  width: 1rpx;
  background-color: #E0E0E0;
  margin: 4rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: var(--light-text);
  margin-bottom: 12rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
  text-align: center;
}

/* 失败原因 */
.result-reason-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #F7F9FC;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 36rpx;
}

.result-reason-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

/* 弹窗按钮 */
.result-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
}
