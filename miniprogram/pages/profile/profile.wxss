.profile-page {
  min-height: 100vh;
  padding: 40rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
  color: #F0E4D0;
}

/* 头部信息卡 */
.profile-header {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 3px solid rgba(232, 184, 112, 0.6);
  margin-bottom: 20rpx;
}

.profile-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #E8B870;
}

.edit-btn {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
}

.edit-icon {
  font-size: 28rpx;
  color: rgba(232, 184, 112, 0.6);
}

.profile-uid {
  font-size: 24rpx;
  color: rgba(232, 184, 112, 0.5);
  margin-bottom: 16rpx;
}

.rank-badge {
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.rank-badge-text {
  font-size: 28rpx;
  color: #FFF8E8;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.rank-progress-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 12rpx;
}

.rank-points-text {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.6);
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.rank-progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(232, 184, 112, 0.15);
  border-radius: 6rpx;
  margin: 0 12rpx;
  overflow: hidden;
}

.rank-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.register-time {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.4);
}

/* 通用 section 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #E8B870;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

/* 对局数据 */
.stats-section {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.stats-tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 24rpx;
  border-bottom: 1px solid rgba(232, 184, 112, 0.15);
}

.stats-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: rgba(232, 184, 112, 0.5);
  border-bottom: 3px solid transparent;
}

.tab-active {
  color: #E8B870;
  border-bottom-color: #E8B870;
}

.stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.stat-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #E8B870;
  margin-bottom: 6rpx;
}

.stat-win {
  color: #6B8E23;
}

.stat-loss {
  color: #CD5C5C;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.5);
}

/* 成就 */
.achievement-section {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.achievement-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.achievement-lock {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.achievement-hint {
  font-size: 26rpx;
  color: rgba(232, 184, 112, 0.4);
}

.achievement-badges {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
}

.badge-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.badge-locked {
  background: rgba(232, 184, 112, 0.1);
  border: 1px dashed rgba(232, 184, 112, 0.2);
  color: rgba(232, 184, 112, 0.2);
}

/* 数据管理 */
.data-section {
  margin-bottom: 32rpx;
}

.data-card {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.data-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.data-label {
  font-size: 30rpx;
  color: #D8C8A8;
}

.data-value {
  font-size: 28rpx;
  color: rgba(232, 184, 112, 0.6);
}

.data-arrow {
  font-size: 32rpx;
  color: rgba(232, 184, 112, 0.4);
}

.data-divider {
  height: 1rpx;
  background: rgba(232, 184, 112, 0.1);
}

.data-danger .data-label {
  color: #CD5C5C;
}

/* 返回按钮 */
.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  color: #FFF8E8;
  border: none;
  margin-top: 16rpx;
}

/* 升段动画 */
.promotion-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: promoFadeIn 0.3s ease-out;
}

.promotion-card {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border-radius: 24rpx;
  padding: 60rpx 80rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.6);
  animation: promoScaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.promotion-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.promotion-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FFF8E8;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.promotion-old {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 248, 232, 0.6);
  margin-bottom: 16rpx;
}

.promotion-arrow {
  font-size: 40rpx;
  color: rgba(255, 248, 232, 0.8);
  margin-bottom: 16rpx;
}

.promotion-new {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #FFF8E8;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.promotion-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 248, 232, 0.4);
}

@keyframes promoFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes promoScaleIn {
  from { transform: scale(0.3); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
