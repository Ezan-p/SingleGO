.settings-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--background);
}

.settings-card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.setting-label {
  font-size: 32rpx;
  color: var(--text-color);
}

.setting-value {
  color: var(--primary-color);
  font-size: 30rpx;
  font-weight: 500;
  padding: 6rpx 24rpx;
  background-color: rgba(30, 136, 229, 0.1);
  border-radius: 24rpx;
}

.setting-divider {
  height: 1rpx;
  background-color: #EEEEEE;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}
