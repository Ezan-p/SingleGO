.match-page {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 匹配中样式 */
.match-container {
  width: 100%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border: 1px solid rgba(232, 184, 112, 0.4);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  text-align: center;
}

.searching-icon {
  margin-bottom: 40rpx;
}

.searching-animation {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 0 auto;
  width: 120rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E8B870;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot1 {
  animation-delay: -0.32s;
}

.dot2 {
  animation-delay: -0.16s;
}

.dot3 {
  animation-delay: 0s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.searching-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF8E8;
  display: block;
  margin-bottom: 16rpx;
}

.waiting-time {
  font-size: 28rpx;
  color: rgba(255, 248, 232, 0.7);
  display: block;
  margin-bottom: 16rpx;
}

.my-rank-text {
  font-size: 26rpx;
  color: #E8B870;
  display: block;
  margin-bottom: 12rpx;
}

.match-range-text {
  font-size: 24rpx;
  color: rgba(255, 248, 232, 0.55);
  display: block;
  margin-bottom: 40rpx;
}

/* 统计信息 */
.stats {
  display: flex;
  justify-content: space-around;
  margin: 40rpx 0;
  padding: 30rpx 0;
  border-top: 2rpx solid rgba(232, 184, 112, 0.25);
  border-bottom: 2rpx solid rgba(232, 184, 112, 0.25);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8B870;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 248, 232, 0.6);
}

/* 取消按钮 */
.cancel-btn {
  margin-top: 40rpx;
  padding: 24rpx 60rpx;
  background: #ff6b6b;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: inline-block;
  transition: all 0.3s;
}

.cancel-btn:active {
  transform: scale(0.95);
  background: #ff5252;
}

/* 匹配成功样式 */
.match-success {
  width: 100%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border: 1px solid rgba(232, 184, 112, 0.4);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  text-align: center;
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: white;
  margin: 0 auto 30rpx;
}

.success-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFF8E8;
  margin-bottom: 50rpx;
}

/* 对手信息 */
.opponent-info {
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.opponent-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  border: 4rpx solid #E8B870;
}

.opponent-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF8E8;
  margin-bottom: 8rpx;
}

.opponent-rank-badge {
  background: rgba(232, 184, 112, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.opponent-rank-text {
  font-size: 24rpx;
  color: #E8B870;
  font-weight: 500;
}

/* 棋子颜色 */
.color-assignment {
  margin-bottom: 40rpx;
}

.color-label {
  font-size: 28rpx;
  color: rgba(255, 248, 232, 0.7);
  margin-bottom: 20rpx;
  display: block;
}

.color-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.stone-preview {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.stone-black {
  background: #000;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.stone-white {
  background: #fff;
  border: 2rpx solid #ddd;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.color-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFF8E8;
}

/* 倒计时 */
.countdown {
  margin: 40rpx 0;
}

.countdown-label {
  font-size: 28rpx;
  color: rgba(255, 248, 232, 0.7);
  display: block;
  margin-bottom: 16rpx;
}

.countdown-number {
  font-size: 80rpx;
  font-weight: 700;
  color: #E8B870;
  display: block;
}

/* 开始按钮 */
.start-btn {
  background: #4CAF50;
  color: white;
  padding: 28rpx 80rpx;
  border-radius: 50rpx;
  font-size: 36rpx;
  font-weight: 600;
  display: inline-block;
  transition: all 0.3s;
}

.start-btn:active {
  transform: scale(0.95);
  background: #45a049;
}
