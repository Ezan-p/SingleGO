<view class="match-page">
  <!-- 匹配状态 -->
  <view class="match-container" wx:if="{{!matched}}">
    <view class="searching">
      <view class="searching-icon">
        <view class="searching-animation">
          <view class="dot dot1"></view>
          <view class="dot dot2"></view>
          <view class="dot dot3"></view>
        </view>
      </view>
      <text class="searching-text">正在寻找对手...</text>
      <text class="waiting-time">已等待 {{waitingTime}} 秒</text>
      <text class="my-rank-text">当前段位：{{myRankName}}</text>
      <text class="match-range-text">匹配范围：{{matchRange}}</text>
      
      <!-- 匹配统计 -->
      <view class="stats" wx:if="{{stats}}">
        <view class="stat-item">
          <text class="stat-value">{{stats.totalWaiting}}</text>
          <text class="stat-label">在线玩家</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.avgWaitTime}}</text>
          <text class="stat-label">平均等待(秒)</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.matchSuccessRate}}%</text>
          <text class="stat-label">匹配成功率</text>
        </view>
      </view>
      
      <view class="cancel-btn" bindtap="onCancelMatch">取消匹配</view>
    </view>
  </view>
  
  <!-- 匹配成功 -->
  <view class="match-success" wx:if="{{matched}}">
    <view class="success-icon">✓</view>
    <text class="success-title">匹配成功！</text>
    
    <!-- 对手信息 -->
    <view class="opponent-info">
      <image class="opponent-avatar" src="{{opponentInfo.avatar}}"></image>
      <text class="opponent-name">{{opponentInfo.nickname}}</text>
      <view class="opponent-rank-badge" wx:if="{{opponentInfo.rankName}}">
        <text class="opponent-rank-text">{{opponentInfo.rankName}}</text>
      </view>
    </view>
    
    <!-- 棋子颜色 -->
    <view class="color-assignment">
      <text class="color-label">您的棋子颜色</text>
      <view class="color-display">
        <view class="stone-preview {{myColor === 'black' ? 'stone-black' : 'stone-white'}}"></view>
        <text class="color-text">{{myColor === 'black' ? '黑棋 (先手)' : '白棋 (后手)'}}</text>
      </view>
    </view>
    
    <!-- 倒计时 -->
    <view class="countdown">
      <text class="countdown-label">对局即将开始</text>
      <text class="countdown-number">{{countdown}}</text>
    </view>
    
    <view class="start-btn" bindtap="onStartGame">立即开始</view>
  </view>
</view>