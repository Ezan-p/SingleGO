<view class="container">
  <view class="user-entry" bindtap="onProfile">
    <image class="user-avatar" src="{{avatar || '/images/avatar.png'}}" />
    <view class="user-info">
      <text class="user-nickname">{{nickname || '未登录'}}</text>
      <text class="user-rank">{{rankName || '棋童'}}</text>
    </view>
  </view>

  <view class="header">
    <text class="title">单围棋</text>
    <text class="subtitle">原创双人棋类对弈</text>
  </view>

  <view class="content">
    <view class="start-card">
      <text class="start-desc">黑方先手，双方轮流落子。围住对方棋子即可获胜，但小心自包围与连续两排判负。</text>
      <view class="btn btn-primary start-btn" bindtap="onStartGame">本地双人</view>
      <view class="btn btn-primary start-btn" bindtap="onFriendBattle">好友对战</view>
      <view class="btn btn-primary start-btn" bindtap="onOnlineBattle">联网对战</view>
      <view class="btn btn-primary start-btn" bindtap="onAIBattle">系统对战</view>
      <view class="btn btn-primary start-btn" bindtap="onChallenge">残局闯关</view>
      <view class="btn btn-primary start-btn" bindtap="onRules">规则说明</view>
      <view class="btn btn-primary start-btn" bindtap="onSettings">设置</view>
    </view>
  </view>
</view>