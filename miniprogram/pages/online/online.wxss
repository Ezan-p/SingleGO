.online-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
  background: radial-gradient(ellipse at 50% 0%, #5C3A1E 0%, #3D2410 55%, #2A1808 100%);
}

/* 对手信息条 */
.players-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.player-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.player-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.player-info-right {
  margin-left: 0;
  margin-right: 16rpx;
  align-items: flex-end;
}

.player-name {
  font-size: 28rpx;
  color: #E8B870;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-tag {
  font-size: 22rpx;
  color: rgba(232, 184, 112, 0.6);
  margin-top: 4rpx;
}

.vs-text {
  font-size: 26rpx;
  color: rgba(232, 184, 112, 0.5);
  margin: 0 12rpx;
}

/* 状态栏 */
.status-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: rgba(58, 38, 20, 0.6);
  border: 1px solid rgba(232, 184, 112, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.player-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stone-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.dot-black {
  background: radial-gradient(circle at 30% 30%, #666 0%, #000 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.dot-white {
  background: radial-gradient(circle at 30% 30%, #fff 0%, #ddd 100%);
  border: 1px solid #999;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #E8B870;
  letter-spacing: 2rpx;
}

.move-count {
  font-size: 28rpx;
  color: rgba(232, 184, 112, 0.7);
}

/* 棋盘（复用 game 页样式） */
.board-wrapper {
  margin: 0 auto 24rpx;
  border: 8rpx solid #7A5230;
  border-radius: 10rpx;
  box-shadow:
    0 10rpx 28rpx rgba(0, 0, 0, 0.28),
    0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  box-sizing: border-box;
  background: radial-gradient(circle at 50% 50%, #F0C478 0%, #DCA558 100%);
  position: relative;
}

.board-grid {
  display: flex;
  flex-wrap: wrap;
  background-image:
    linear-gradient(to right, #3a2f1f 1px, transparent 1px),
    linear-gradient(to bottom, #3a2f1f 1px, transparent 1px);
}

.cell {
  position: relative;
  box-sizing: border-box;
}

.star-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16%;
  height: 16%;
  border-radius: 50%;
  background-color: #3a2f1f;
  z-index: 1;
}

.stone {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  height: 90%;
  border-radius: 50%;
  z-index: 2;
}

.stone-black {
  background: radial-gradient(circle at 30% 30%, #666666 0%, #000000 100%);
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.35);
}

.stone-white {
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, #dddddd 100%);
  border: 1px solid #999999;
  box-shadow: 1px 2px 4px rgba(0, 0, 0, 0.15);
}

.last-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96%;
  height: 96%;
  border-radius: 50%;
  border: 3px solid #E8B870;
  box-sizing: border-box;
  z-index: 3;
}

/* 结果横幅 */
.result-banner {
  background: linear-gradient(135deg, #C8923C 0%, #8B5A2B 100%);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.result-title {
  color: #FFF8E8;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.result-reason {
  color: rgba(255, 248, 232, 0.85);
  font-size: 26rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ctrl-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.btn-leave {
  background: transparent;
  color: #E8B870;
  border: 1px solid rgba(232, 184, 112, 0.6);
}
